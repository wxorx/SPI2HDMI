.program i2s_capture

; Standard I2S (MSB) 16-bit Capture (1-clock delay)
; Retro-Go ESP32 output format (I2S_COMM_FORMAT_STAND_I2S)
; IN base = DATA (GPIO 8); BCK is polled as base+1 (GPIO 9), so DATA and BCK
; must stay consecutive. WS is polled with absolute `wait gpio` operands
; (GPIO 20), so it does not need to be consecutive with DATA/BCK.

    ; Sync to WS falling edge (Left channel boundary)
    wait 1 gpio 20
    wait 0 gpio 20

.wrap_target
    ; === LEFT CHANNEL (WS LOW) ===
    set x, 15
left_loop:
    wait 0 pin 1
    wait 1 pin 1
    in pins, 1
    jmp x-- left_loop
    
    ; === RIGHT CHANNEL (WS HIGH) ===
    wait 0 gpio 20
    wait 1 gpio 20
    
    set x, 15
right_loop:
    wait 0 pin 1
    wait 1 pin 1
    in pins, 1
    jmp x-- right_loop
    
    ; Push both channels as one 32-bit word
    ; Left is in upper 16 bits, Right is in lower 16 bits.
    push noblock
    
    ; Wait for WS falling edge to align with next frame start
    wait 1 gpio 20
    wait 0 gpio 20
.wrap

% c-sdk {
#include "hardware/gpio.h"

static inline void i2s_capture_program_init(PIO pio, uint sm, uint offset, uint pin_dat, uint pin_ws, uint pin_bck) {
    // Constraints from the program text: pin_bck must equal pin_dat + 1
    // (BCK is polled relative to the IN base), and pin_ws must be GPIO 20
    // (WS is polled with absolute wait gpio operands).
    pio_sm_config c = i2s_capture_program_get_default_config(offset);

    // IN pin base = DAT
    sm_config_set_in_pins(&c, pin_dat);

    // Shift LEFT (MSB first), no autopush.
    // Left channel shifts in first, pushed to bits 31:16.
    // Right channel shifts in second, pushed to bits 15:0.
    sm_config_set_in_shift(&c, false, false, 32);

    // Join FIFOs for 8-word RX depth
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    pio_gpio_init(pio, pin_dat);
    pio_gpio_init(pio, pin_bck);
    pio_gpio_init(pio, pin_ws);

    pio_sm_set_pindirs_with_mask64(pio, sm, 0,
        (1ull << pin_dat) | (1ull << pin_bck) | (1ull << pin_ws));

    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
}
%}